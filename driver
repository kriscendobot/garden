#!/usr/bin/env bash
# driver — enter a driver container that runs systemd as PID 1
# and manages the garden's per-lane driver and per-feed watcher units.
#
# Analogous to the `garden` launcher, with these differences:
#   * Uses Dockerfile.driver (installs systemd + dbus).
#   * Runs detached, --privileged, with a writable cgroup mount and the
#     tmpfs mounts systemd needs at /run, /run/lock, /tmp.
#   * Default hostname is `kriscendobot` (the bot identity this container
#     uses, vs `garden`'s `endolinbot`).
#   * Default bind-mount source is ${SCRIPT_DIR}/driver-home, NOT the
#     garden root, so the container's kriscendobot identity has no path
#     to the garden or journal repositories. Override with DRIVER_HOME.
#
# Credentials constraint:
#   kriscendobot must NOT have write access to kriskowal/garden (main or
#   journal). Configure the bot's GitHub permissions and the host's ssh
#   key accordingly: the kriscendobot ssh key may have push to fork
#   repos (endojs/endo-but-for-bots, kriscendobot/*) but NEVER to the
#   garden. The bind mount enforces the same: DRIVER_HOME points at a
#   host directory that does NOT contain the garden or journal git
#   worktrees, so even a buggy driver can't reach them.
#
#   The driver's local-only journal writes (per-lane state files,
#   transcript hashing, gardener-inbox entries) land in a journal-
#   shaped subdirectory under DRIVER_HOME. A separate sync process,
#   running under endolinbot identity in the garden container, picks
#   them up and lands them on kriskowal/garden:journal. The driver
#   itself never pushes anywhere it could harm.

set -euo pipefail

IMAGE_NAME="${DRIVER_IMAGE:-driver}"
CONTAINER_NAME="${DRIVER_CONTAINER:-driver}"
HOSTNAME_NAME="${DRIVER_HOSTNAME:-kriscendobot}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DRIVER_HOME_DEFAULT="${SCRIPT_DIR}/driver-home"
DRIVER_HOME="${DRIVER_HOME:-${DRIVER_HOME_DEFAULT}}"

usage() {
    cat <<EOF
Usage: $(basename "$0") [command [args]]

Commands:
  (no args)        Start the container if needed and exec a login shell as kris.
  build            Build (or rebuild) the container image from Dockerfile.driver.
  reset            Remove the container so the next invocation creates a fresh one.
  up               Start the container detached (idempotent); do not enter.
  status           List active systemd units.
  start <unit>...  systemctl start (passed verbatim).
  stop <unit>...   systemctl stop (passed verbatim).
  enable <unit>... systemctl enable (passed verbatim).
  disable <unit>... systemctl disable (passed verbatim).
  logs <unit> [args]  journalctl -u <unit> (extra args appended; e.g. --since 1h).
  daemons-start    Run scripts/daemons/start.sh inside the container as kris.
  daemons-stop     Run scripts/daemons/stop.sh inside the container as kris.
  daemons-status   Run scripts/daemons/status.sh inside the container as kris.

Environment:
  ANTHROPIC_API_KEY   Forwarded to the container for Claude Code auth.
  DRIVER_IMAGE        Override image name (default: driver).
  DRIVER_CONTAINER    Override container name (default: driver).
  DRIVER_HOSTNAME     Override container hostname (default: kriscendobot).
  DRIVER_HOME         Host directory bind-mounted to /home/kris inside the
                      container (default: ${DRIVER_HOME_DEFAULT}). MUST NOT
                      contain or have access to the garden or journal git
                      worktrees; kriscendobot must not be able to touch
                      kriskowal/garden.

Notes:
  Unlike garden, driver runs systemd as PID 1 inside the container.
  This requires --privileged and a writable cgroup mount; both are
  supplied automatically here. The container reads scripts/daemons/
  config.sh (host-local) for which lanes and feeds to enable. See
  scripts/systemd/README.md for unit-file conventions.

  The bot SSH key and gh config under \$HOME/.ssh and \$HOME/.config/gh
  (i.e. \$DRIVER_HOME/.ssh and \$DRIVER_HOME/.config/gh on the host)
  must hold kriscendobot credentials — and ONLY credentials whose blast
  radius is fork repos. The kriscendobot key must not have write
  permission to kriskowal/garden via any GitHub team or SSH key fingerprint.
EOF
    exit 1
}

cmd_build() {
    docker build -f "$SCRIPT_DIR/Dockerfile.driver" -t "$IMAGE_NAME" "$SCRIPT_DIR"
}

cmd_reset() {
    if docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        docker rm -f "$CONTAINER_NAME" >/dev/null
        echo "Removed container '$CONTAINER_NAME'."
    else
        echo "No container '$CONTAINER_NAME' to remove."
    fi
}

require_image() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        echo "Image '$IMAGE_NAME' not found. Run '$(basename "$0") build' first." >&2
        exit 1
    fi
}

require_driver_home() {
    if [[ ! -d "$DRIVER_HOME" ]]; then
        echo "DRIVER_HOME does not exist: $DRIVER_HOME" >&2
        echo "Create it and populate with the kriscendobot scripts subtree" >&2
        echo "and credentials under .ssh/ and .config/gh/ before running." >&2
        echo "DRIVER_HOME must NOT be the garden root (which contains the" >&2
        echo "garden + journal git worktrees the kriscendobot identity must" >&2
        echo "not touch)." >&2
        exit 1
    fi
    # The dangerous case is DRIVER_HOME pointing at the active garden
    # operating root, whose distinctive markers are the live orchestrator
    # state directories dispatches/ and worktrees/ (per-dispatch worktrees
    # and bare fork clones the steward and liaison populate). The driver
    # has its own local journal/ (a standalone git repo that a separate
    # endolinbot sync process later moves upstream), so journal/ alone
    # is not a danger marker.
    local driver_home_resolved
    driver_home_resolved="$(cd "$DRIVER_HOME" && pwd)"
    if [[ -d "$driver_home_resolved/dispatches" \
       || -d "$driver_home_resolved/worktrees" ]]; then
        echo "DRIVER_HOME appears to be the active garden operating root:" >&2
        echo "  $driver_home_resolved" >&2
        echo "It contains dispatches/ or worktrees/ — orchestrator-only state" >&2
        echo "the kriscendobot identity must not have filesystem access to." >&2
        echo "Point DRIVER_HOME at a separate host directory." >&2
        exit 1
    fi
}

cmd_up() {
    require_image
    require_driver_home
    if ! docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        local api_key_args=()
        if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
            api_key_args=(-e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
        fi

        # systemd as PID 1 requires:
        #   * --privileged (or a careful capability set: CAP_SYS_ADMIN
        #     + CAP_NET_ADMIN + CAP_SYS_PTRACE + CAP_AUDIT_WRITE, plus
        #     cgroup delegation). --privileged is the pragmatic choice
        #     for a developer-managed bot container.
        #   * Writable cgroup v2 mount so systemd can create slices.
        #   * tmpfs at /run, /run/lock, /tmp for systemd's runtime state.
        #   * STOPSIGNAL SIGRTMIN+3 (set in Dockerfile.driver) so
        #     `docker stop` triggers a clean systemd shutdown.
        docker run -d \
            --name "$CONTAINER_NAME" \
            --hostname "$HOSTNAME_NAME" \
            --privileged \
            --cgroupns=host \
            --tmpfs /run \
            --tmpfs /run/lock \
            --tmpfs /tmp \
            -v /sys/fs/cgroup:/sys/fs/cgroup:rw \
            -v "${DRIVER_HOME}:/home/kris" \
            "${api_key_args[@]}" \
            "$IMAGE_NAME" >/dev/null
        echo "Started container '$CONTAINER_NAME' (bind mount: $DRIVER_HOME)."
        wait_for_user_bus
    elif [[ "$(docker container inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" != "true" ]]; then
        docker start "$CONTAINER_NAME" >/dev/null
        echo "Started existing container '$CONTAINER_NAME'."
        wait_for_user_bus
    fi
}

# Block until kris's per-user systemd bus is reachable, so that
# subsequent `systemctl --user` calls (in cmd_daemons and friends)
# don't race the container's boot. systemd needs to bring up
# user@1000.service after the container starts, which takes a few
# seconds on a cold boot.
wait_for_user_bus() {
    local deadline=$((SECONDS + 30))
    while (( SECONDS < deadline )); do
        if docker exec "$CONTAINER_NAME" test -S /run/user/1000/bus 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    echo "warning: user@1000 bus did not appear within 30s; daemon commands may fail" >&2
    return 1
}

cmd_enter() {
    cmd_up
    exec docker exec -it -u kris "$CONTAINER_NAME" /bin/bash -l
}

cmd_status() {
    cmd_up
    docker exec "$CONTAINER_NAME" systemctl list-units --type=service --no-pager
}

cmd_systemctl() {
    local verb=$1; shift
    if [[ $# -eq 0 ]]; then
        echo "${verb}: at least one unit required" >&2
        exit 64
    fi
    cmd_up
    docker exec "$CONTAINER_NAME" systemctl "$verb" "$@"
}

cmd_logs() {
    if [[ $# -lt 1 ]]; then
        echo "logs: a unit name is required" >&2
        exit 64
    fi
    local unit=$1; shift
    cmd_up
    docker exec "$CONTAINER_NAME" journalctl -u "$unit" --no-pager "$@"
}

cmd_daemons() {
    local script=$1
    cmd_up
    # The daemon scripts use `systemctl --user`, which needs the
    # XDG_RUNTIME_DIR and DBUS_SESSION_BUS_ADDRESS env vars to find
    # the per-user systemd manager's bus. `docker exec -u kris`
    # (without a login shell) does not set these.
    docker exec -u kris \
        -e XDG_RUNTIME_DIR=/run/user/1000 \
        -e DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
        "$CONTAINER_NAME" "/home/kris/scripts/daemons/${script}.sh"
}

if [[ $# -eq 0 ]]; then
    cmd_enter
fi

case "$1" in
    build)   shift; cmd_build "$@" ;;
    reset)   shift; cmd_reset "$@" ;;
    up)      shift; cmd_up "$@" ;;
    status)  shift; cmd_status "$@" ;;
    start)   shift; cmd_systemctl start "$@" ;;
    stop)    shift; cmd_systemctl stop "$@" ;;
    enable)  shift; cmd_systemctl enable "$@" ;;
    disable) shift; cmd_systemctl disable "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    daemons-start)  shift; cmd_daemons start ;;
    daemons-stop)   shift; cmd_daemons stop ;;
    daemons-status) shift; cmd_daemons status ;;
    -h|--help|help) usage ;;
    *) usage ;;
esac
