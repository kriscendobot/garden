#!/usr/bin/env bash
# garden — enter a local bot container whose home directory is
# this script's parent directory on the host.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# The container's unix user is baked to MATCH the host user running ./garden —
# same login name and same uid — so the bind-mounted home stays writable and
# nothing is hardcoded to one maintainer's account. Because the identity is baked
# at build time, the image is tagged per-user (garden-<user>): two users on one
# host get separate images instead of clobbering a shared `garden` tag (the drift
# that a single hardcoded user would cause). HOST_USER/HOST_UID feed --build-arg
# in cmd_build and `docker exec -u` when entering.
HOST_USER="$(id -un)"
HOST_UID="$(id -u)"
IMAGE_NAME="${GARDEN_IMAGE:-garden-${HOST_USER}}"

# The instance identity — the GARDEN name the fleet keys off — is derived purely
# from WHERE this checkout lives: <hostname>-<basename>-<hash8> of the canonical
# path. Location IS the identity, which means:
#   - two checkouts on one host never collide (distinct paths -> distinct ids),
#   - re-entering the same directory always re-attaches to the SAME container
#     (the id is stable across invocations), and
#   - the id is unique across hosts as long as short-hostnames are — an
#     assumption the fleet already makes (common.sh falls back to `hostname -s`).
# There is no .garden file and no env knob to seed, edit, or forget, so the
# identity can never drift away from the container after creation (the failure
# that used to strand a container under a name matching neither checkout). Inside
# the container the fleet resolves this id via the `hostname -s` fallback in
# scripts/jobs/common.sh — we pin --hostname to it below. GARDEN_CONTAINER /
# GARDEN_HOSTNAME remain expert overrides for the rare split cases.
INSTANCE_PATH="$(cd "$SCRIPT_DIR" && pwd -P)"
_host="$(hostname -s 2>/dev/null | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
_base="$(basename "$INSTANCE_PATH" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
_hash="$(printf %s "$INSTANCE_PATH" | sha256sum | head -c 8)"
INSTANCE_ID="${_host:-host}-${_base:-garden}-${_hash}"

CONTAINER_NAME="${GARDEN_CONTAINER:-$INSTANCE_ID}"
HOSTNAME_NAME="${GARDEN_HOSTNAME:-$INSTANCE_ID}"

# Explicit container DNS. On a systemd-resolved host, /etc/resolv.conf is the
# loopback stub (127.0.0.53), which Docker cannot pass into a container; it falls
# back to the host's legacy uplink list, which on a home/LAN network is the router
# (e.g. 192.168.1.254). That router answers the host but is NOT reachable from the
# docker bridge, so every in-container lookup times out and the fleet cannot resolve
# api.anthropic.com — non-DNS egress still works, so it looks like a partial outage.
# Pin public resolvers so name resolution is independent of the host's DNS shape.
# Space-separated; override with GARDEN_DNS="1.2.3.4 5.6.7.8" (empty string = let
# Docker choose, restoring the old behavior).
GARDEN_DNS="${GARDEN_DNS-1.1.1.1 8.8.8.8}"

usage() {
    cat <<EOF
Usage: $(basename "$0") [command]

Commands:
  (no args)   Enter the container (building the image and creating or starting
              the container as needed) and exec Claude Code — the liaison — in
              auto mode as the foreground process.
  codex       Enter the container and exec Codex CLI in yolo mode
              (--dangerously-bypass-approvals-and-sandbox) instead of Claude
              Code — the OpenAI-agent entry point.
  sh          Enter the container and open an interactive login shell instead
              of Claude Code — the debugging escape hatch.
  create      Create/start the container (bringing systemd and the garden
              --user units up) WITHOUT attaching Claude Code. The headless
              bring-up path — e.g. standing up a follower.
  build       Build (or rebuild) the container image. Bare \`$(basename "$0")\`
              auto-builds when the image is absent; this is for explicit
              rebuilds. Stamps the build-contract digest (Dockerfile + copied
              inputs) into the image so freshness can be checked later.
  check       Report whether the built image is fresh (matches the current
              Dockerfile + build inputs) or STALE. Exits non-zero only when a
              built, tracked image no longer matches its source — a gate for a
              Dockerfile-affecting deploy. A bare \`$(basename "$0")\` also warns
              on a stale image at bring-up (never auto-rebuilds).
  reset       Remove the container so the next invocation creates a fresh one.

Environment:
  ANTHROPIC_API_KEY   Forwarded to the container for Claude Code auth.
  MOONSHOT_API_KEY    Forwarded to the container for hosted Kimi workers.
  FIREWORKS_API_KEY   Forwarded to the container for Fireworks workers.
  GARDEN_IMAGE        Override image name (default: garden-<hostuser>, so the
                      per-user baked image never collides with another user's).
  GARDEN_CONTAINER    Expert override for the container name (default: the
                      location-derived instance id <hostname>-<basename>-<hash>).
  GARDEN_HOSTNAME     Expert override for the container --hostname (default:
                      the same location-derived instance id).
  GARDEN_DNS          Space-separated DNS servers pinned into the container
                      (default: "1.1.1.1 8.8.8.8"). Empty string lets Docker
                      derive resolv.conf from the host (the old behavior).

Notes:
  The container runs systemd as PID 1 so the garden's user-mode units
  (scripts/systemd/garden-*) can run. After entering, say \`help\` and the
  liaison walks the first-run setup, or \`start the garden\` to bring the
  fleet up.

  Instance identity is derived entirely from this checkout's LOCATION —
  <hostname>-<basename>-<hash8> of the canonical path — so it needs no env
  vars or config files and cannot drift. To run several instances on one
  host, put each in its own directory: distinct paths yield distinct ids,
  distinct containers, and distinct homes. The container home is MIRRORED to
  the checkout's own host path — the same absolute path inside the container
  and on the host — so an absolute path never denotes two different things.

  Unlike town, garden does NOT forward SSH_AUTH_SOCK. The bot uses its own
  keys under \$HOME/.ssh/ (this checkout's own .ssh on the host) so that an
  agent-forwarded human identity cannot leak into bot actions.
EOF
    exit 1
}

# The image's build CONTRACT is the set of local inputs `docker build` consumes:
# the Dockerfile and every file it COPYs (the entrypoint and the api-key-handoff
# seed). Its digest is stamped into the built image as a label at build time
# (cmd_build) and compared on every bring-up (ensure_container) and by `./garden
# check`. So a change to any of them — notably the Dockerfile's browser-runtime
# dependency layer (the apt libraries a headless browser needs to launch, which a
# gardener's Playwright/UI acceptance run relies on) — flips a pre-existing image
# to STALE instead of being silently reused until the next deliberate rebuild. The
# guard was previously absent-only: it built when the image was missing but never
# noticed a missing image was better than a stale one.
GARDEN_CONTRACT_LABEL="garden.build-contract-sha"

# The files docker build actually consumes, in a fixed order so the digest is
# stable. Keep this in sync with the Dockerfile's COPY lines.
build_contract_inputs() {
    printf '%s\n' \
        "$SCRIPT_DIR/Dockerfile" \
        "$SCRIPT_DIR/entrypoint.sh" \
        "$SCRIPT_DIR/scripts/systemd/seed-api-key-handoff.sh"
}

# sha256 of the concatenated build inputs. Missing inputs (a partial checkout)
# contribute nothing rather than aborting, so `check` still runs; the Dockerfile
# is always present in a real tree.
build_contract_sha() {
    local f
    while IFS= read -r f; do
        [[ -f "$f" ]] && cat "$f"
    done < <(build_contract_inputs) | sha256sum | cut -d' ' -f1
}

# The contract digest recorded in the built image, or empty when the image was
# built before this label existed (an image we cannot assert staleness against).
image_contract_sha() {
    docker image inspect \
        -f "{{ index .Config.Labels \"$GARDEN_CONTRACT_LABEL\" }}" \
        "$IMAGE_NAME" 2>/dev/null || true
}

cmd_build() {
    docker build \
        --allow network.host \
        --network host \
        --build-arg "USERNAME=${HOST_USER}" \
        --build-arg "USER_UID=${HOST_UID}" \
        --label "${GARDEN_CONTRACT_LABEL}=$(build_contract_sha)" \
        -t "$IMAGE_NAME" "$SCRIPT_DIR"
}

# Warn (do not act) when a pre-existing image no longer matches the build
# contract. Warn-only on purpose: an auto-rebuild mid-bring-up would be a
# minutes-long surprise on a live host, and the running container keeps its old
# image until a deliberate `reset` + re-enter anyway. An image with NO recorded
# label predates contract tracking; we cannot assert it is stale, so we stay
# silent rather than nag — a present-but-different label is the only definite
# mismatch.
warn_if_image_stale() {
    local want have
    want="$(build_contract_sha)"
    have="$(image_contract_sha)"
    [[ -n "$have" && "$have" != "$want" ]] || return 0
    {
        echo "WARNING: image '$IMAGE_NAME' is STALE — its build inputs (Dockerfile,"
        echo "         entrypoint, api-key-handoff seed) changed since it was built,"
        echo "         so any new browser-runtime deps or tooling are NOT in it yet."
        echo "         Rebuild and recreate the container to pick them up:"
        echo "             $(basename "$0") build && $(basename "$0") reset"
        echo "         (the next '$(basename "$0")' then recreates it from the fresh image)."
    } >&2
}

cmd_reset() {
    if docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        docker rm -f "$CONTAINER_NAME" >/dev/null
        echo "Removed container '$CONTAINER_NAME'."
    else
        echo "No container '$CONTAINER_NAME' to remove."
    fi
}

# Seed $SCRIPT_DIR/.claude/settings.json host-side, exactly like .garden and
# only when absent (a hand-edited file is preserved). The container's home IS
# the bind-mounted repo root, so this one file covers both the user-level
# (~/.claude/settings.json) and project-level (<repo>/.claude/settings.json)
# scopes at once. It carries a SessionStart hook running the container guard,
# making the guard automatic for every session that starts in the garden root —
# INCLUDING a host-side session, which is exactly where the guard must fire — plus
# `cleanupPeriodDays: 36500` so Claude Code's 30-day transcript deletion is
# disabled from the first session (the transcript archive keeps the garden's
# record; designs/transcript-journal-capture.md). transcript-capture.sh reconciles
# the same key on existing hosts, since this file is gitignored and cannot
# propagate via git. It deliberately does NOT set a permission defaultMode: the settings file
# is visible host-side too, so a settings-level bypass would silently make
# host-side sessions permissionless. Auto mode rides the launch flag instead
# (see the exec in cmd_enter), which applies only to the in-container session.
seed_claude_settings() {
    local settings="${SCRIPT_DIR}/.claude/settings.json"
    [[ -e "$settings" ]] && return 0
    mkdir -p "${SCRIPT_DIR}/.claude"
    cat > "$settings" <<'JSON'
{
  "cleanupPeriodDays": 36500,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/check-in-container.sh\""
          }
        ]
      }
    ]
  }
}
JSON
}

# Build the image if absent, then create the container if absent (seeding the
# durable identity and settings on creation), or start it if stopped. Shared by
# cmd_enter (execs claude) and cmd_sh (execs a login shell).
ensure_container() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        echo "Image '$IMAGE_NAME' not found; building it now ('$(basename "$0") build' to rebuild later)." >&2
        cmd_build
    else
        warn_if_image_stale
    fi

    if ! docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        # Values are passed directly to Docker at creation and never logged.
        # PID 1 seeds only these allowlisted values into /run/environment.d;
        # systemd's environment-d generator then gives them to the separately
        # PAM-started lingering user manager. The handoff is tmpfs-only.
        local api_key_args=()
        if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
            api_key_args=(-e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
        fi
        if [[ -n "${MOONSHOT_API_KEY:-}" ]]; then
            api_key_args+=(-e "MOONSHOT_API_KEY=${MOONSHOT_API_KEY}")
        fi
        if [[ -n "${FIREWORKS_API_KEY:-}" ]]; then
            api_key_args+=(-e "FIREWORKS_API_KEY=${FIREWORKS_API_KEY}")
        fi

        # Seed the container guard's SessionStart hook (host-side, only when
        # absent). The instance identity needs no seeding — it is derived from
        # the checkout location at every invocation (see INSTANCE_ID above).
        seed_claude_settings

        # One --dns per configured resolver (see GARDEN_DNS above). Empty = omit,
        # letting Docker derive resolv.conf from the host as before.
        local dns_args=()
        local _d
        for _d in $GARDEN_DNS; do dns_args+=(--dns "$_d"); done

        # systemd as PID 1 needs the containerized-systemd flags: a writable
        # cgroup mount, tmpfs at /run and /tmp, the host cgroup namespace,
        # and its clean-shutdown stop signal. --hostname pins this instance's
        # logical name (the location-derived INSTANCE_ID), which keys journal
        # claim metadata, hosts/<host>, and per-host state.
        #
        # Home is MIRRORED: the checkout is bind-mounted at its own host path
        # (not a fixed /home/<user>), and GARDEN_HOME tells the entrypoint to
        # relocate the bot user's home there (usermod -d) before systemd starts.
        # So $HOME, the login shell, and the --user manager all agree on the
        # mirrored path, and absolute paths mean the same thing inside and out.
        docker run -d \
            --name "$CONTAINER_NAME" \
            --hostname "$HOSTNAME_NAME" \
            --privileged \
            --cgroupns=host \
            -v /sys/fs/cgroup:/sys/fs/cgroup:rw \
            --tmpfs /run --tmpfs /run/lock --tmpfs /tmp \
            --stop-signal SIGRTMIN+3 \
            "${dns_args[@]}" \
            -e "GARDEN_HOME=${INSTANCE_PATH}" \
            -v "${INSTANCE_PATH}:${INSTANCE_PATH}" \
            "${api_key_args[@]}" \
            "$IMAGE_NAME" >/dev/null
    elif [[ "$(docker container inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" != "true" ]]; then
        docker start "$CONTAINER_NAME" >/dev/null
    fi
}

# Drop into the container as the bot user ($HOST_USER, matching the host uid),
# NOT root. PID 1 (systemd) must run as root and the ENTRYPOINT owns that, so the
# image's default USER stays root; we override it here per-exec. Entering as the
# bot user means the interactive session (and the `claude` it launches) uses that
# user's gh/ssh credentials and manages the garden's `systemctl --user` units
# directly — no `sudo -u <user>`, and no root-vs-user credential split.
#
# `bash -lc` loads /etc/profile.d/garden.sh (PATH) and then `exec claude`
# replaces the login shell with Claude Code as the foreground process on the
# allocated tty — no shell in between. --dangerously-skip-permissions is auto
# mode: it applies ONLY to this in-container session (not the host-visible
# settings file), matching the fleet's existing headless posture. Exiting claude
# exits the exec and returns to the host shell; the container and fleet keep
# running, and `./garden` re-enters.
# Bring the instance up WITHOUT attaching: create/start the container (so systemd,
# lingering, and the garden --user units come up) and report its id, but do not
# exec claude. The headless bring-up path — useful for scripts and for standing up
# a follower without opening a liaison session.
cmd_create() {
    ensure_container
    echo "Container '$CONTAINER_NAME' is up (home mirrored at $INSTANCE_PATH)."
    echo "Enter it with: $(basename "$0")   (or '$(basename "$0") sh' for a shell)"
}

cmd_enter() {
    ensure_container
    exec docker exec -it -u "$HOST_USER" -w "$INSTANCE_PATH" "$CONTAINER_NAME" \
        /bin/bash -lc 'exec claude --dangerously-skip-permissions'
}

# Same entry as cmd_enter, but exec Codex CLI in yolo mode instead of Claude.
# --dangerously-bypass-approvals-and-sandbox is Codex's auto/yolo posture (skip
# every confirmation, no internal sandbox); it is documented as intended solely
# for an externally sandboxed environment, which the container is — the exact
# analog of the `claude --dangerously-skip-permissions` posture above, and it
# applies ONLY to this in-container session.
cmd_codex() {
    ensure_container
    exec docker exec -it -u "$HOST_USER" -w "$INSTANCE_PATH" "$CONTAINER_NAME" \
        /bin/bash -lc 'exec codex --dangerously-bypass-approvals-and-sandbox'
}

# Report whether the built image matches the current build contract, so the
# deploy procedure (context/operations/deploy.md) can gate a Dockerfile-affecting
# deploy on a rebuild. Exit 0 when fresh — or when there is no image yet, or an
# image that predates contract tracking (nothing we can call stale); exit 1 only
# when a built, labelled image definitely no longer matches its source inputs.
cmd_check() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        echo "Image '$IMAGE_NAME' not built yet — nothing to check ('$(basename "$0") build' to create it)."
        return 0
    fi
    local want have
    want="$(build_contract_sha)"
    have="$(image_contract_sha)"
    if [[ -z "$have" ]]; then
        echo "Image '$IMAGE_NAME' predates build-contract tracking; rebuild to enable freshness checks ('$(basename "$0") build')."
        return 0
    fi
    if [[ "$have" == "$want" ]]; then
        echo "Image '$IMAGE_NAME' is fresh (build contract ${want:0:12})."
        return 0
    fi
    {
        echo "Image '$IMAGE_NAME' is STALE:"
        echo "    image build contract:   ${have:0:12}"
        echo "    current source contract: ${want:0:12}"
        echo "Rebuild and recreate: $(basename "$0") build && $(basename "$0") reset"
    } >&2
    return 1
}

# The debugging escape hatch: a login shell instead of claude — yesterday's
# enter behavior verbatim.
cmd_sh() {
    ensure_container
    exec docker exec -it -u "$HOST_USER" -w "$INSTANCE_PATH" "$CONTAINER_NAME" /bin/bash -l
}

if [[ $# -eq 0 ]]; then
    cmd_enter
    exit 0
fi

case "$1" in
    codex) shift; cmd_codex "$@" ;;
    sh) shift; cmd_sh "$@" ;;
    create) shift; cmd_create "$@" ;;
    build) shift; cmd_build "$@" ;;
    check) shift; cmd_check "$@" ;;
    reset) shift; cmd_reset "$@" ;;
    -h|--help|help) usage ;;
    *) usage ;;
esac
