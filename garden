#!/usr/bin/env bash
# garden — enter a local bot container whose home directory is
# this script's parent directory on the host.

set -euo pipefail

IMAGE_NAME="${GARDEN_IMAGE:-garden}"
CONTAINER_NAME="${GARDEN_CONTAINER:-garden}"
HOSTNAME_NAME="${GARDEN_HOSTNAME:-endolinbot}"
# The durable shard identity (the GARDEN name the fleet keys off). Defaults to
# the container hostname, but is captured into a gitignored $HOME/.garden file
# (see below) so it survives independently of the kernel hostname and of any
# env var — an exported GARDEN never reaches the systemd --user manager. Override
# GARDEN at creation time to give a pool an identity distinct from its hostname
# (e.g. a follower pool "endolinbot2" on a host whose hostname is "endolinbot").
# GARDEN_SHARD is accepted as a deprecated alias for the same knob.
SHARD_NAME="${GARDEN:-${GARDEN_SHARD:-$HOSTNAME_NAME}}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
    cat <<EOF
Usage: $(basename "$0") [command]

Commands:
  (no args)   Enter the container, creating or starting it as needed.
  build       Build (or rebuild) the container image.
  reset       Remove the container so the next invocation creates a fresh one.

Environment:
  ANTHROPIC_API_KEY   Forwarded to the container for Claude Code auth.
  GARDEN_IMAGE        Override image name (default: garden).
  GARDEN_CONTAINER    Override container name (default: garden).
  GARDEN_HOSTNAME     Override container hostname (default: endolinbot).
  GARDEN              Override the durable shard identity written to
                      \$HOME/.garden at container creation (default:
                      GARDEN_HOSTNAME). This is the GARDEN name the fleet
                      keys off; set it when a pool's identity must differ
                      from its hostname (e.g. a follower "endolinbot2").
  GARDEN_SHARD        Deprecated alias for GARDEN (honored for one release
                      so existing pools that set it keep working; prefer
                      GARDEN).

Notes:
  The container runs systemd as PID 1 so the garden's user-mode units
  (scripts/systemd/garden-*) can run. After entering, bring the fleet up
  per CLAUDE.md § Job system: install-units.sh install && enable-services,
  then set-gardeners.sh <N> <host>. The shard identity MUST be unique across
  instances; to run several, give each a distinct GARDEN_CONTAINER and
  GARDEN (or GARDEN_HOSTNAME). The identity is captured in the
  gitignored \$HOME/.garden file so it is durable and per-instance — an
  exported GARDEN env var does NOT reach the systemd --user units.

  Unlike town, garden does NOT forward SSH_AUTH_SOCK. The bot uses its
  own keys under \$HOME/.ssh/ (i.e. /home/kris/garden/.ssh on the host)
  so that an agent-forwarded human identity cannot leak into bot actions.
EOF
    exit 1
}

cmd_build() {
    docker build -t "$IMAGE_NAME" "$SCRIPT_DIR"
}

cmd_reset() {
    if docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        docker rm -f "$CONTAINER_NAME" >/dev/null
        echo "Removed container '$CONTAINER_NAME'."
    else
        echo "No container '$CONTAINER_NAME' to remove."
    fi
}

cmd_enter() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        echo "Image '$IMAGE_NAME' not found. Run '$(basename "$0") build' first." >&2
        exit 1
    fi

    if ! docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        local api_key_args=()
        if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
            api_key_args=(-e "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
        fi

        # Seed the durable shard identity. The home dir is bind-mounted from
        # $SCRIPT_DIR, so writing $SCRIPT_DIR/.garden here makes it appear at
        # /home/kris/.garden inside the container, where common.sh reads it (it
        # is gitignored, so it never enters shared git history). Written only at
        # creation and only when absent, so a hand-edited identity is preserved.
        if [[ ! -e "${SCRIPT_DIR}/.garden" ]]; then
            printf '%s\n' "$SHARD_NAME" > "${SCRIPT_DIR}/.garden"
        fi

        # systemd as PID 1 needs the containerized-systemd flags: a writable
        # cgroup mount, tmpfs at /run and /tmp, the host cgroup namespace,
        # and its clean-shutdown stop signal. --hostname pins this instance's
        # logical name, which MUST be unique across garden instances (it keys
        # journal claim metadata, hosts/<host>, and per-host state).
        docker run -d \
            --name "$CONTAINER_NAME" \
            --hostname "$HOSTNAME_NAME" \
            --privileged \
            --cgroupns=host \
            -v /sys/fs/cgroup:/sys/fs/cgroup:rw \
            --tmpfs /run --tmpfs /run/lock --tmpfs /tmp \
            --stop-signal SIGRTMIN+3 \
            -v "${SCRIPT_DIR}:/home/kris" \
            "${api_key_args[@]}" \
            "$IMAGE_NAME" >/dev/null
    elif [[ "$(docker container inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" != "true" ]]; then
        docker start "$CONTAINER_NAME" >/dev/null
    fi

    # Drop into the container as kris (uid 1000), NOT root. PID 1 (systemd)
    # must run as root and the ENTRYPOINT owns that, so the image's default
    # USER stays root; we override it here per-exec. Entering as kris means
    # the interactive session (and any `claude` it launches) uses kris's
    # gh/ssh credentials and manages the garden's `systemctl --user` units
    # directly — no `sudo -u kris`, and no root-vs-kris credential split.
    exec docker exec -it -u kris "$CONTAINER_NAME" /bin/bash -l
}

if [[ $# -eq 0 ]]; then
    cmd_enter
    exit 0
fi

case "$1" in
    build) shift; cmd_build "$@" ;;
    reset) shift; cmd_reset "$@" ;;
    -h|--help|help) usage ;;
    *) usage ;;
esac
