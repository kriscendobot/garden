# Garden working trees managed outside main.
# These are separate git worktrees / bare clones; do not track them from main.
/journal/
/journal-worktrees/
/worktrees/
/dispatches/
/v1/
/repos/

# Dedicated job scratch. Every job's ephemeral scratch files and ad-hoc
# worktrees live under /scratch/ (GARDEN_SCRATCH; see scripts/jobs/common.sh
# scratch_dir/scratch_cleanup and roles/COMMON.md § Scratch discipline). It is
# never tracked, so a job that dirties files there can never block the
# watchman fast-forward. Never create scratch dirs or worktrees at the live
# tree root; route them through /scratch/.
/scratch/

# Docker container detritus. The garden directory is bind-mounted as the
# container's $HOME (see ./garden, Dockerfile), so any dotfile the bot or
# its tools create — including the kriscendobot SSH keys and gh oauth
# token under .ssh/ and .config/gh/ — lands here. Never committed.
# Pattern matches every top-level dotfile/dir except ./.gitignore itself.
/.[!.]*

# Carve back the few top-level dotfile paths we do want tracked. Add
# more here when a new tracked dotfile path is introduced. The
# .github/ directory holds CI workflows that GitHub reads from the
# repo root.
!/.gitignore
!/.github/
!/.github/**

# Host-local daemon configuration for the driver pool and per-feed
# watchers. The .example template is checked in; the actual config.sh
# is host-local. See scripts/daemons/README.md.
/scripts/daemons/config.sh

# Host-local private working notes (if any) are excluded via each host's
# .git/info/exclude, so their filenames never enter tracked history.
