#!/bin/bash
# gh — fleet identity wrapper.
#
# WHY THIS EXISTS
# The garden's systemd units carry no GH_TOKEN, so a bare `gh` resolves its
# identity from the *global active account* in ~/.config/gh/hosts.yml. That file
# is mutable: any `gh auth switch` anywhere flips it, and on the maintainer's host
# it can point at `kriskowal` (the human). When it did, every fleet gh action
# (reactji, PR comments, reviews, merges, forks) silently acted AS THE MAINTAINER
# — an identity leak (see designs/fleet-gh-identity.md and the
# harden-fleet-gh-identity job).
#
# THE FIX
# This wrapper sits at the FRONT of the fleet's PATH (prepended in
# scripts/jobs/common.sh, which every fleet entrypoint sources, so the change
# propagates to every child — including the `claude -p` gardener subagents and
# their Bash tool calls). It makes the fleet's gh identity DETERMINISTIC and
# independent of the global active account:
#
#   * Default → the bot (kriscendobot). The wrapper injects the bot's *live*
#     token (read fresh from gh's own store each call, so it never goes stale)
#     unless an explicit, auditable override is present.
#   * Override → set GARDEN_GH_IDENTITY=<login> to resolve a different account's
#     token, OR pre-set GH_TOKEN yourself to pass a token through untouched.
#     This is the boatman's authorized-kriskowal path: it must set the override
#     EXPLICITLY (GARDEN_GH_IDENTITY=kriskowal) for an upstream-acting call.
#     Routine work that sets nothing can never silently become kriskowal — the
#     override is one-directional by construction (bot is the floor, never the
#     reverse).
#
# This wrapper only affects processes whose PATH includes scripts/jobs/bin
# (i.e. the fleet). A maintainer's interactive shell is untouched and keeps
# whatever active account they chose.
set -euo pipefail

# The login whose token we resolve when the caller has not pre-set GH_TOKEN.
# Default is the bot. The boatman sets GARDEN_GH_IDENTITY=kriskowal for an
# authorized upstream ferry; nothing else should set it.
: "${GARDEN_GH_IDENTITY:=kriscendobot}"

# Resolve the REAL gh, skipping this wrapper (which is first on PATH). `command
# gh` would re-find this wrapper (command bypasses functions/aliases, not PATH
# order) and recurse, so walk `type -aP gh` and take the first entry that is not
# this file.
self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
real_gh=""
while IFS= read -r cand; do
  [ "$cand" = "$self" ] && continue
  real_gh="$cand"; break
done < <(type -aP gh 2>/dev/null)
[ -n "$real_gh" ] || { printf 'gh-wrapper: no real gh found on PATH after %s\n' "$self" >&2; exit 127; }

# gh_is_write — true (rc 0) when argv is a STATE-CHANGING gh invocation. Used only
# in the unresolved-token fallback below to decide fail-closed vs degrade. The set
# is the mutating surface the fleet actually drives: pr/issue lifecycle verbs, the
# reactji/comment POSTs (which go through `gh api … -X POST`), and any mutating
# `gh api`. Read-only calls (default `api` GET, pr/issue view|list, auth status,
# repo/run/release view|list, search, …) are NOT matched, so pollers and detectors
# keep degrading tolerantly. The list is one-sided on purpose: a genuine write we
# fail closed on is correct; the only harm would be misclassifying a read, so we
# match only verbs that are unambiguously mutating.
gh_is_write() {
  local cmd="${1:-}" sub="${2:-}"
  case "$cmd" in
    pr)
      case "$sub" in
        create|comment|review|merge|edit|close|reopen|ready|lock|unlock) return 0;;
      esac;;
    issue)
      case "$sub" in
        create|comment|edit|close|reopen|delete|lock|unlock|pin|unpin|transfer) return 0;;
      esac;;
    release)
      case "$sub" in
        create|edit|delete|upload) return 0;;
      esac;;
    api)
      _gh_api_is_write "${@:2}" && return 0;;
  esac
  return 1
}

# _gh_api_is_write — true when a `gh api` call mutates. gh defaults to GET, but an
# explicit -X/--method other than GET/HEAD is a write, and any field flag
# (-f/--raw-field, -F/--field) with no explicit read method makes gh POST — a
# write (this is how the reactji/comment handlers post: `-X POST … -f content=…`).
# An explicit `-X GET` that also carries -f/-F keeps the fields as query params, so
# it stays a read. Value-bearing flags are consumed as flag+value so a header/jq
# value like `-X` can never be misread as the method flag, and the first bare
# positional is captured as the endpoint (used only for the graphql carve-out).
_gh_api_is_write() {
  local method="" has_field=0 endpoint=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -X|--method)     method="${2:-}"; shift; [ "$#" -gt 0 ] && shift; continue;;
      -X=*|--method=*) method="${1#*=}"; shift; continue;;
      -f|--raw-field|-F|--field)         has_field=1; shift; [ "$#" -gt 0 ] && shift; continue;;
      -f=*|--raw-field=*|-F=*|--field=*) has_field=1; shift; continue;;
      # other value-bearing flags: consume flag+value so the value is not mistaken
      # for the endpoint positional below.
      -H|--header|-q|--jq|-t|--template|--input|--hostname|--cache)
                       shift; [ "$#" -gt 0 ] && shift; continue;;
      -*)              shift;;  # boolean/unknown flag (--paginate, --slurp, -i, …)
      *)               [ -z "$endpoint" ] && endpoint="$1"; shift;;
    esac
  done
  # `gh api graphql` is ALWAYS a POST (the GraphQL transport), yet the fleet uses
  # it as a READ — mirror-pr-state / mirror-closer read PR state via `api graphql
  # -f query=…`. Classify graphql as a read so those pollers keep degrading rather
  # than fail-closing on a token-less host. (A rare graphql *mutation* would degrade
  # too; the field heuristic cannot tell them apart, and not breaking every graphql
  # read is the priority the job requires.)
  [ "$endpoint" = graphql ] && return 1
  if [ -n "$method" ]; then
    case "$method" in
      [Gg][Ee][Tt]|[Hh][Ee][Aa][Dd]) return 1;;
      *) return 0;;
    esac
  fi
  [ "$has_field" -eq 1 ] && return 0
  return 1
}

# If the caller already chose a token, honor it untouched (explicit override,
# including the boatman pre-setting GH_TOKEN directly). Otherwise inject the
# resolved identity's live token. `env -u GH_TOKEN` keeps the token lookup itself
# from being skewed by any inherited GH_TOKEN.
if [ -z "${GH_TOKEN:-}" ]; then
  if tok="$(env -u GH_TOKEN "$real_gh" auth token --user "$GARDEN_GH_IDENTITY" 2>/dev/null)" && [ -n "$tok" ]; then
    export GH_TOKEN="$tok"
  elif gh_is_write "$@"; then
    # Could not resolve the intended identity's token AND this is a mutating call.
    # Exec'ing the bare gh here would perform the action as the GLOBAL active
    # account — on the maintainer's host, the human (the #521 failure: a PR opened
    # under the maintainer instead of @kriscendobot). Fail CLOSED: block the write
    # and surface it, so the calling role handles the gap instead of landing work
    # under the wrong identity.
    # The backticked hint below is literal operator prose, not a command
    # substitution — the whole format string is single-quoted on purpose.
    # shellcheck disable=SC2016
    printf 'gh-wrapper: ERROR kind:error could not resolve token for identity=%s; REFUSING a state-changing gh call (%s %s …) rather than acting as the global active account. Fix: log %s in on this host (`gh auth login`), pre-set GH_TOKEN, or set GARDEN_GH_IDENTITY to an available identity.\n' \
      "$GARDEN_GH_IDENTITY" "${1:-}" "${2:-}" "$GARDEN_GH_IDENTITY" >&2
    exit 1
  else
    # Could not resolve the intended identity's token (account not logged in on
    # this host?), but this is a READ. Degrade to the bare gh baseline rather than
    # break every fleet poller/detector — but say so loudly. A read mis-attributed
    # to the global account returns the same data; only writes leak, and those are
    # already blocked above.
    printf 'gh-wrapper: WARNING could not resolve token for identity=%s; falling back to the global active account for a read-only call (writes fail closed)\n' \
      "$GARDEN_GH_IDENTITY" >&2
  fi
fi

# --- durable garden-job marker on `gh pr create` -------------------------------
# A job claimed more than once must converge on ONE pull request. ensure-pr.sh is
# the deterministic converger, but only for a PR whose body CARRIES the
# `<!-- garden-job: <base> -->` marker its discovery queries on. A bare
# `gh pr create` (a still-documented follow-up/stacked path, and how the node-24x-ci
# job opened endojs/endo-but-for-bots#999) writes no marker, so a cross-host requeue
# cannot rediscover it and re-creates (#999/#1000). Stamping the marker HERE — the
# one PATH chokepoint every fleet gh call crosses — makes EVERY fleet-opened PR
# rediscoverable regardless of the code path. It only ADDS an invisible HTML comment
# (never blocks, never changes a rendered byte, only `pr create` is touched), so it
# cannot regress any flow. Fail-open by construction: pr-job-marker.sh returns rc 1
# (passthrough) for a non-create, an absent/invalid $GARDEN_JOB_BASE, a bodyless
# (--fill/editor) create, or any parse doubt. See
# designs/requeue-rediscover-prior-work.md.
_prjm_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/pr-job-marker.sh"
if [ -r "$_prjm_lib" ]; then
  # shellcheck source=../pr-job-marker.sh
  . "$_prjm_lib" 2>/dev/null || true
  if declare -f pr_job_marker_rewrite_argv >/dev/null 2>&1 \
     && pr_job_marker_rewrite_argv "$@" 2>/dev/null; then
    # A `pr create` is never a comment, so the provenance step below would no-op on
    # it — run the marked argv directly (not exec, so the temp body file is cleaned).
    "$real_gh" "${PRJM_NEWARGV[@]}"; _prjm_rc=$?
    declare -f pr_job_marker_cleanup >/dev/null 2>&1 && pr_job_marker_cleanup
    exit "$_prjm_rc"
  fi
fi

# --- GitHub-comment provenance footer (maintainer directive 2026-07-28) --------
# Every PR/issue comment the fleet posts carries a small-text footer naming the
# model, harness, and DEPLOYED garden sha (hyperlinked). Enforcing it HERE — the
# single PATH chokepoint every fleet gh call passes through — is far more reliable
# than a skill telling agents to remember (roles/mentor/AGENT.md). The rewrite is
# fail-open by construction: comment-provenance.sh returns rc 1 (passthrough) for
# every non-comment call, an already-footed body, an unresolvable footer, or ANY
# parse doubt, so the exec below is unchanged for the overwhelming majority of
# calls (reads, reactji, merges, label edits). Only a genuine comment-create is
# rewritten, and even then a body that cannot be footered posts as-is.
_prov_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/comment-provenance.sh"
if [ -r "$_prov_lib" ]; then
  # shellcheck source=../comment-provenance.sh
  . "$_prov_lib" 2>/dev/null || true
  if declare -f provenance_rewrite_argv >/dev/null 2>&1 \
     && provenance_rewrite_argv "$@" 2>/dev/null; then
    "$real_gh" "${PROV_NEWARGV[@]}"; _prov_rc=$?
    declare -f provenance_cleanup >/dev/null 2>&1 && provenance_cleanup
    exit "$_prov_rc"
  fi
fi

exec "$real_gh" "$@"
