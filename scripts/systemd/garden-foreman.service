[Unit]
Description=Garden foreman (keep the board topped up to the active-job target)

[Service]
Type=oneshot
# A systemd stop mid-tick SIGTERMs the run; a signalled shutdown is a CLEAN
# exit, not a failure. The self-heal wrapper already normalizes 143/130 to 0;
# this is the belt-and-suspenders so any future bypass of the wrapper still
# doesn't mark a SIGTERM stop as Failed.
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# --- active-job target --------------------------------------------------------
# The foreman keeps this many concurrent jobs (jobs/todo/ + jobs/doin/) actively
# progressing, filling the open slots while the board is under-subscribed. The
# script default is 3 (kriskowal, 2026-07-03: keep ~3 jobs actively progressing),
# but the fleet foreman is intentionally QUIESCED: set to 0 (kriskowal, 2026-07-14)
# so the board is never "under target" and the foreman NEVER pumps -- fleet-wide, on
# every host that becomes leader. Raise here (or via a per-host drop-in) to re-enable.
# (GARDEN_FOREMAN_WIP is the deprecated former name, still honored as an alias.)
Environment=GARDEN_FOREMAN_ACTIVE_TARGET=0
# --- temporary provider preference during the Claude quota constraint --------
# Leave this unset for the ordinary Claude-only posture (the handler default is
# `anthropic`). While the quota is constrained, set a systemd drop-in or this
# environment line to `openai,local,anthropic`: Codex first, then the local Qwen
# Ollama endpoint, then Claude as the last fallback. Remove it next week to restore
# the normal `anthropic` order. See context/operations/foreman-providers.md.
# Environment=GARDEN_FOREMAN_PROVIDER_ORDER=openai,local,anthropic
# --- weekly token meter / back-off gate (Claude Max x20 subscription) ---------
# The foreman is the garden's autonomous token pump, so it gates on a deterministic
# weekly token meter sourced from Claude Code's OWN session logs
# (~/.claude/projects/**/*.jsonl) — NOT the Admin Usage/Cost API, which does not
# apply to a subscription. See scripts/jobs/usage-meter.sh for the full design.
#
# The per-account cap is loaded from journal config/budget-pools by this host's
# GARDEN identity. The seeded values are conservative placeholders until the
# maintainer supplies `/usage`-derived caps; missing/unreadable config fails open.
# GARDEN_TOKEN_WEEKLY_QUOTA remains a test/emergency fallback when no pool row is
# available.
# Optional tunables (defaults shown; uncomment to override):
#   Environment=GARDEN_TOKEN_BACKOFF_FRACTION=0.85   # back off at 85% of quota
# The quota cutoff is fixed at Friday 21:00 America/Los_Angeles (DST-aware).
#   Environment=GARDEN_TOKEN_COUNT_CACHE_READ=0      # 1 = also count cache_read
#   Environment=GARDEN_CCUSAGE_LOGDIR=%h/.claude/projects  # session-log location
# Leader-only singleton: run only on the host whose GARDEN identity matches the
# journal `leader` marker. On a follower the timer still fires but this
# ExecCondition fails, so the tick is SKIPPED CLEANLY (condition-failed, never
# marked Failed) — that IS follower mode. Each firing re-evaluates, so a
# leader change (promotion/demotion) is picked up next tick with no restart.
# See issue kriskowal/garden#11 (Multibot) and designs/multibot-leader-follower.md.
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-foreman -- @GARDEN_ROOT@/scripts/jobs/foreman.sh
# The self-heal responder runs synchronously on a failed tick before the
# wrapper returns the failing rc; give it headroom beyond the implicit 90s
# oneshot start timeout so a diagnosis is not cut off (responder itself is
# hard-bounded by SELF_HEAL_RESPONDER_TIMEOUT).
TimeoutStartSec=900
