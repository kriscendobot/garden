[Unit]
Description=Garden mentor timer

[Timer]
# Absolute wall-clock schedule (every 30 minutes at :20 / :50), NOT a relative
# OnActiveSec/OnUnitActiveSec pair: a relative first-elapse window larger than the
# fleet's ~1-minute daemon-reload cadence is re-armed before it elapses and can be
# deferred indefinitely (see garden-library-source-drift-scan.timer). Persistent=true
# catches up a run missed across downtime.
OnCalendar=*:20/30
Persistent=true

[Install]
WantedBy=timers.target
