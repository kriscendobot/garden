[Unit]
Description=Garden PR gauntlet-readiness audit timer

[Timer]
# Absolute wall-clock schedule (hourly at :37), NOT a relative OnActiveSec/
# OnUnitActiveSec pair: a relative first-elapse window larger than the fleet's
# ~1-minute daemon-reload cadence is re-armed before it elapses and can be deferred
# indefinitely (see garden-library-source-drift-scan.timer for the full rationale;
# garden-orchestrate.timer starved for real on this exact bug). Offset to minutes
# ending in 2 or 7 so it runs clear of the clone-keeper (:00/:30) and
# journal-worktree-keeper (:15/:45) fetch windows. Five minutes closes the race
# between opening and merging a new ready PR. Each tick stages at most two PRs
# created after the audit's durable arm
# epoch; the historical backlog remains alert-only, so the 2026-08-30 mass-stage
# cost class ($482) cannot recur. Persistent=true catches up a run missed across
# downtime; loss of local arm state safely re-baselines instead of staging backlog.
OnCalendar=*:2/5
Persistent=true

[Install]
WantedBy=timers.target
