[Unit]
Description=Garden fixed-operation secret broker
After=default.target

[Service]
Type=exec
Environment=GARDEN_ROOT=@GARDEN_ROOT@
ExecStart=/usr/bin/python3 @GARDEN_ROOT@/scripts/outbound/broker.py
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@GARDEN_ROOT@/.garden-state @GARDEN_ROOT@/scratch

[Install]
WantedBy=default.target
