[Unit]
Description=Garden design-PR gauntlet-coverage audit (periodic backstop: stage a design gauntlet for any bot-authored OPEN design-only PR that has none — the third coverage layer the completion-time stager/sensor leave to "the audit", covering the non-draft-at-birth case they cannot; kriscendobot/minion.town#47)

[Service]
Type=oneshot
# A systemd stop mid-tick SIGTERMs the run; a signalled shutdown is a CLEAN exit,
# not a failure. The self-heal wrapper already normalizes 143/130 to 0; this is the
# belt-and-suspenders so any future bypass of the wrapper still doesn't mark a
# SIGTERM stop as Failed.
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# Leader-only singleton: run only on the host whose GARDEN identity matches the
# journal `leader` marker. Staging is CAS-pushed and idempotent per PR, but running
# it on every host would multiply the gh enumeration cost for no benefit. On a
# follower the timer still fires but this ExecCondition fails, so the tick is SKIPPED
# CLEANLY (condition-failed, never marked Failed). Each firing re-evaluates, so a
# leader change is picked up next tick with no restart.
# See issue kriskowal/garden#11 (Multibot) and designs/multibot-leader-follower.md.
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-design-pr-gauntlet-audit -- @GARDEN_ROOT@/scripts/jobs/design-pr-gauntlet-coverage-audit.sh
# The self-heal responder runs synchronously on a failed tick before the wrapper
# returns the failing rc; give it headroom beyond the implicit 90s oneshot start
# timeout. The sweep itself bounds every per-repo PR-source read
# (GARDEN_DPGCA_SOURCE_TIMEOUT_SECS, default 180s each) but reads a small active set.
TimeoutStartSec=900
