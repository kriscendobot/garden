[Unit]
Description=Garden container-hardening probe (assert the unprivileged posture — empty effective caps, no passwordless sudo, no host block devices, no maintainer gh/ssh credential — so a container recreated from an old/privileged image or launcher gets noticed)

[Service]
Type=oneshot
# A systemd stop mid-tick SIGTERMs the run (a CLEAN exit, not a failure), exit 2
# is the probe's SKIP (run off-container), and exit 3 is PENDING RECREATE (never
# verified hardened yet; reported via one coalesced watchdog notice). Treat all as
# success so only a genuine posture regression (exit 1) marks the unit Failed — a
# failed garden-* unit fails rolling-deploy canaries and drains the host.
SuccessExitStatus=2 3 143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# EVERY host (NOT leader-gated): every host runs its own container, so the posture
# must be asserted everywhere — no ExecCondition.
# --expect 2 / --expect 3 so SKIP (off-container) and PENDING RECREATE are CLEAN
# exits that never spawn a self-heal responder; a genuine regression (exit 1) still
# does, surfacing it.
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-container-hardening --expect 2 --expect 3 -- @GARDEN_ROOT@/scripts/check-container-hardening.sh
TimeoutStartSec=120
