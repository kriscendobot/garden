[Unit]
Description=Garden gardener worker %i
# A consumer in the worker pool. Scale by enabling instances @1..@N.
After=default.target
# CollectMode is a [Unit] key (it was mis-placed under [Service], which systemd
# rejected with "Unknown key name 'CollectMode' in section 'Service'").
CollectMode=inactive-or-failed
# A deploy-sync.sh window advances the live checkout in place while units may be
# (re)starting; a transient absent/unreadable script could otherwise burst
# 203/EXEC failures that count toward StartLimitBurst and wedge a worker DOWN past
# the deploy. ExecStart now execs /bin/bash (always present, never 203/EXEC), and
# StartLimitIntervalSec=0 disables the start-rate limiter so no burst of failures
# during a deploy can hold this worker DOWN indefinitely.
StartLimitIntervalSec=0

[Service]
Type=exec
Slice=background.slice
# A systemd stop/restart SIGTERMs this loop; a signalled shutdown is a CLEAN
# exit, not a failure. The self-heal wrapper already normalizes 143/130 to 0;
# this is the belt-and-suspenders so any future bypass of the wrapper still
# doesn't trip the Restart=on-failure path on a clean stop.
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-gardener --work-id %i -- @GARDEN_ROOT@/scripts/jobs/gardener.sh %i
# long-running loop; keep it up if it dies, but back off
Restart=on-failure
RestartSec=5
# Graceful drain on stop/restart. The default KillMode=control-group would SIGTERM
# the WHOLE cgroup the instant systemd stops this unit — including the in-flight
# handler subtree (the `timeout … claude -p` doing the job) — so any stop (manual,
# leader-promotion fleet restart, deploy edge, or the busy-gate TOCTOU race) kills
# the handler mid-job (rc=143) → the job requeues and burns a poison cycle, with
# the work thrown away. KillMode=mixed sends the initial SIGTERM ONLY to the main
# worker process (self-heal-run.sh, which forwards it to gardener.sh's loop); the
# handler subtree is left running. gardener.sh traps that SIGTERM as a "stop after
# the current job" request and exits cleanly at its next between-claims point, so
# the running job finishes instead of being abandoned. TimeoutStopSec must then be
# long enough for systemd to WAIT for that finish rather than escalating to a
# cgroup-wide SIGKILL: size it ≥ GARDEN_HANDLER_TIMEOUT (2400) +
# GARDEN_HANDLER_KILL_AFTER (60) plus slack (gardener.sh § handler-timeout knobs).
# If those knobs are raised, raise this in lock-step. On expiry, mixed still
# SIGKILLs the whole cgroup as the hard backstop, so a genuinely wedged handler
# cannot hold the stop open past this bound.
KillMode=mixed
TimeoutStopSec=2700
# Per-worker memory confinement. Today this unit has no Memory* or OOMPolicy keys,
# so a memory spike in one handler pressures the WHOLE host and the kernel OOM
# killer picks an arbitrary victim across every process — it once caught
# gardener-8 (self-restarts, tolerable), but the same unconfined pressure can
# instead snipe a leader-only singleton (foreman/scheduler/watchers, which double
# nothing but simply die) or a mid-job peer whose SIGKILLed `claude -p` handler
# then requeues and burns a poison TTL cycle — the very rc=143/requeue outage class
# the KillMode=mixed/TimeoutStopSec block above already guards on the stop/restart
# path but leaves open on the OOM path. Accounting + a per-worker cgroup limit
# contain the eventual kill to the offending worker so it restarts cleanly instead.
MemoryAccounting=yes
# Soft throttle: at MemoryHigh systemd applies reclaim/swap pressure to THIS
# worker's cgroup BEFORE any kill, so a transient spike degrades into swap (the
# host has 8G swap, 128G RAM) rather than a hard kill.
MemoryHigh=6G
# Hard cap: the eventual OOM is confined to this worker's cgroup, so the killer
# targets it deterministically and it self-restarts, never sniping an innocent
# process. Sized to comfortably hold one `claude -p` handler plus the node/yarn
# toolchains a job builds with. TUNING: the xs2rust / rust-build family are the
# memory-heaviest handlers (a large cargo/LTO build can spike well past a node
# build); if such a job is OOM-killed below its real need, raise MemoryMax (and
# MemoryHigh in step) here rather than adding a background.slice aggregate cap —
# an aggregate cap would let one hungry worker starve its idle peers' headroom.
MemoryMax=8G

[Install]
WantedBy=default.target
