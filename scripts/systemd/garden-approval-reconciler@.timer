[Unit]
Description=Garden approval reconciler timer for repo %i

[Timer]
# Bind the instance timer explicitly to its same-instance service.
Unit=garden-approval-reconciler@%i.service
# OnBootSec anchors the first elapse to a FIXED monotonic reference (boot), so the
# timer always has a concrete next-trigger and fires promptly on arming;
# OnUnitActiveSec drives the steady cadence after the first run. The reconciler is a
# BACKSTOP behind the real-time comment/CI watchers (90s), so it runs on a slow,
# API-thrifty cadence — a missed approval is recovered within one interval, and each
# tick reads ~2 API calls per approved PR. Mirrors garden-ci-watcher@.timer's anchor.
OnBootSec=2min
OnUnitActiveSec=15min
# Default accuracy is 1min, which is fine for a 15min cadence; leave it batched.

[Install]
WantedBy=timers.target
