[Unit]
Description=Garden bulletin (continuous: keep the journal bulletin current as the board advances)
After=default.target
# CollectMode is a [Unit] key (it was mis-placed under [Service], which systemd
# rejected with "Unknown key name 'CollectMode' in section 'Service'").
CollectMode=inactive-or-failed
# The bulletin is the maintainer's live dashboard; it must NEVER be permanently
# killable by a crash loop. With a finite start-limit, rapid Restart=always
# cycles trip systemd's rate limiter and it STOPS restarting (root cause of the
# 2026-06-25 ~2h dark window). Disable the start-limit so the service always
# self-recovers; the tick-level resilience in bulletin.sh means it should never
# crash-loop in the first place, but this is the belt to that fix's suspenders.
StartLimitIntervalSec=0

[Service]
# Long-running loop, NOT a oneshot+timer. The loop debounces by being busy and
# polls a short idle sleep when the board is quiet; it IS the watcher. Keep it up
# if it dies, with a restart backoff.
Type=exec
Slice=background.slice
# A systemd stop/restart SIGTERMs this loop; a signalled shutdown is a CLEAN
# exit, never a failure. The self-heal wrapper already normalizes 143/130 to 0,
# but treat the signal codes (and the kill-by-signal forms) as success here too
# so any future bypass of the wrapper still doesn't flap the unit to Failed.
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
ExecStart=@GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-bulletin -- @GARDEN_ROOT@/scripts/jobs/bulletin.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
