[Unit]
Description=Garden minion.town MCP watchdog (probe token + MCP initialize/tools/list through the worker stdio bridge, reconnect on failure, edge-latched alert, heartbeat)

[Service]
Type=oneshot
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# EVERY host (NOT leader-gated): each host has its own token cache and AWS credential
# path, so each host can lose the connection independently — no ExecCondition. The
# tick honors the config/minion-mcp gate itself and records a `disabled` heartbeat.
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-minion-mcp-watchdog -- @GARDEN_ROOT@/scripts/jobs/minion-mcp-watchdog.sh
TimeoutStartSec=600
