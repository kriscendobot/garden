[Unit]
Description=Garden dependabot-PR watcher timer for repo %i

[Timer]
# Bind the instance timer explicitly to its same-instance service.
Unit=garden-dependabot-watcher@%i.service
# OnBootSec anchors the first elapse to a FIXED monotonic reference (boot), so the
# timer always has a concrete next-trigger and fires promptly on arming;
# OnUnitActiveSec drives the steady cadence after the first run. A new dependabot PR
# is not latency-sensitive (the botanist embargoes non-CVE bumps a week anyway), so
# a slower cadence than the CI watcher keeps the enumeration cost low. Mirrors
# garden-ci-watcher@.timer's anchor shape.
OnBootSec=90s
OnUnitActiveSec=300s
# Spread the ~15 per-repo template instances across the cadence instead of firing
# every one in the same second. Without this, all instances anchor to the same
# boundary and hit `gh api` simultaneously every cadence — a self-inflicted
# thundering herd GitHub answers with 5xx/HTML/rate-limit blips the watchers then
# correctly but wastefully skip. Scaled up from garden-ci-watcher's 30s spread to
# this timer's slower 300s cadence.
RandomizedDelaySec=90s
# Default accuracy is 1min; tighten so the cadence does not get batched late.
AccuracySec=1s

[Install]
WantedBy=timers.target
