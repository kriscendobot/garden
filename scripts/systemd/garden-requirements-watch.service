[Unit]
Description=Garden host-requirements watcher (surface unclaimable capability-gated jobs)

[Service]
Type=oneshot
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-requirements-watch -- @GARDEN_ROOT@/scripts/jobs/requirements-watch.sh
TimeoutStartSec=900
