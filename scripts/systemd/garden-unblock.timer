[Unit]
Description=Garden unblock watcher timer

[Timer]
# Absolute wall-clock schedule (every 5 minutes at :01 past), NOT a relative
# OnActiveSec/OnUnitActiveSec pair: a relative first-elapse window larger than the
# fleet's ~1-minute daemon-reload cadence is re-armed before it elapses and can be
# deferred indefinitely (see garden-orchestrate.timer, which starved for real on
# 2026-07-03). This one starved for real on 2026-07-14..16: the leader's unblock
# watcher never fired (LastTrigger empty for 2+ days), so a `gate: blocked` plan
# whose blocker had already completed (port-xs-to-rust-memory-safe-engine-s19)
# sat parked for 5 days. Persistent=true catches up a run missed across downtime.
OnCalendar=*:01/5
Persistent=true

[Install]
WantedBy=timers.target
