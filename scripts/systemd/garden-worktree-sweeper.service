[Unit]
Description=Garden terminal-worktree sweeper (reclaim completed, doomed, and orphaned checkouts)

[Service]
Type=oneshot
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# Root-repo worktree administration is leader-owned; workers never touch it.
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-worktree-sweeper -- @GARDEN_ROOT@/scripts/jobs/worktree-sweeper.sh
TimeoutStartSec=1800

