[Unit]
Description=Garden minion.town delegated PR screening

[Service]
Type=oneshot
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# Leader-only singleton. Keeping this separate from garden-proxy gives a normal
# contended GitHub pass its own 30-minute budget instead of the proxy's 10-minute
# self-heal deadline. The tick supervisor reports any bounded overrun itself.
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
Environment=SELF_HEAL_HANDLER_TIMEOUT=0
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-minion-town-screening -- @GARDEN_ROOT@/scripts/jobs/screen-delegated-prs-tick.sh
TimeoutStartSec=2100
