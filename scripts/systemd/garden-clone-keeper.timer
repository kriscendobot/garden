[Unit]
Description=Garden clone-keeper timer

[Timer]
# Absolute wall-clock schedule (every 30 minutes at :00 / :30), NOT a relative
# OnActiveSec/OnUnitActiveSec pair: a relative first-elapse window larger than the
# fleet's ~1-minute daemon-reload cadence is re-armed before it elapses and can be
# deferred indefinitely (see garden-library-source-drift-scan.timer for the full
# rationale). The :00/:30 anchor keeps clone-keeper ahead of the drift-scan (:07)
# and journal-worktree-keeper (:15/:45) so the bare clones are fast-forward-fresh
# before either audits against them. Persistent=true catches up a missed run.
OnCalendar=*:00/30
Persistent=true

[Install]
WantedBy=timers.target
