[Unit]
Description=Garden gardener-scaler (reconcile local gardener pool to journal host count)
# A deploy-sync.sh window advances the live checkout in place while this oneshot
# may be (re)starting; ExecStart execs /bin/bash (always present, never 203/EXEC)
# and StartLimitIntervalSec=0 disables the start-rate limiter so a deploy-window
# burst of failures never wedges the scaler DOWN indefinitely.
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=GARDEN_ROOT=@GARDEN_ROOT@
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-gardener-scaler -- @GARDEN_ROOT@/scripts/jobs/gardener-scaler.sh
# The self-heal responder runs synchronously on a failed tick before the
# wrapper returns the failing rc; give it headroom beyond the implicit 90s
# oneshot start timeout so a diagnosis is not cut off (responder itself is
# hard-bounded by SELF_HEAL_RESPONDER_TIMEOUT).
TimeoutStartSec=900
