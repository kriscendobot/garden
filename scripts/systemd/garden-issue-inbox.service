[Unit]
Description=Garden issue-inbox watcher (the garden's own repo issues → maintainer inbox)
# Producer: watch the garden's OWN GitHub repo's issues + issue-comments and
# dispatch jobs/messages so a maintainer can drive the garden by filing/commenting
# on an issue. Driven by its .timer. Safe on a PUBLIC repo by construction: a
# DETERMINISTIC maintainer-trust gate (allowlist-only, NO LLM) drops every
# non-maintainer author BEFORE any body is read (see issue-inbox-watcher.sh). The
# watcher is INERT until the journal carries config/garden-repo AND a non-empty
# maintainers/allowlist — writing those (set-garden-repo.sh / add-maintainer.sh)
# is the deliberate per-instance arming act, so this unit may be enabled normally.

[Service]
Type=oneshot
# A systemd stop mid-tick SIGTERMs the run; a signalled shutdown is a CLEAN exit,
# not a failure. The self-heal wrapper normalizes 143/130 to 0; this is the
# belt-and-suspenders so any future bypass of the wrapper still doesn't mark a
# SIGTERM stop as Failed.
SuccessExitStatus=143 130 SIGTERM SIGINT
# Graceful drain on stop/restart. The default KillMode=control-group would SIGTERM
# the WHOLE cgroup the instant systemd stops this unit — but a git credential
# helper forked by the issue source's `gh api --paginate` may ignore/outrace that
# TERM and linger in the cgroup, so the next start flags "Found left-over process
# (git) in control group while starting unit" (the observed 00:36:21 three-orphan
# leak). KillMode=mixed instead sends the initial SIGTERM ONLY to the main process
# (self-heal-run.sh, which forwards it to issue-inbox-watcher.sh); the watcher's
# EXIT/INT/TERM trap then reaps the source's whole process group (gh + every git
# child) deterministically — signalling the negated PGID and then WAITING for the
# group to drain so the cgroup is empty before the main process exits — and the
# cgroup-wide SIGKILL backstop at TimeoutStopSec catches anything the process-group
# reap cannot reach (e.g. a gh child placed in its OWN process group). Mirrors
# garden-comment-watcher@.service (same producer-leak class).
KillMode=mixed
# Short stop timeout: the issue poll holds NO in-flight work worth preserving (a
# killed tick simply re-polls next firing — the cursor only advances on a verified
# dispatch), so we do NOT wait minutes on stop. A SHORT bound makes the cgroup-wide
# SIGKILL backstop fell any straggler the process-group reap missed WELL BEFORE the
# next firing, instead of letting the default DefaultTimeoutStopSec (~90s) race the
# timer that fires the next instance. 20s is ample for the trap's TERM→drain (itself
# bounded by the source `timeout`'s --kill-after) yet far below the timer cadence.
TimeoutStopSec=20s
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# Leader-only singleton: run only on the host whose GARDEN identity matches the
# journal `leader` marker. On a follower the timer still fires but this
# ExecCondition fails, so the tick is SKIPPED CLEANLY (condition-failed, never
# marked Failed) — that IS follower mode. Each firing re-evaluates, so a
# leader change (promotion/demotion) is picked up next tick with no restart.
# Same producer-double-post class as the comment/mention watchers (a follower
# triager would re-post the same repo activity; a follower issue-inbox would
# double-reply a maintainer). See issue kriskowal/garden#11 (Multibot).
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-issue-inbox -- @GARDEN_ROOT@/scripts/jobs/issue-inbox-watcher.sh
# The self-heal responder runs synchronously on a failed tick before the wrapper
# returns the failing rc; give it headroom beyond the implicit 90s oneshot start
# timeout so a diagnosis is not cut off (responder itself is hard-bounded by
# SELF_HEAL_RESPONDER_TIMEOUT).
TimeoutStartSec=900
