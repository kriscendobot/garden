[Unit]
Description=Garden staged-gauntlet driver (walk a PR one claim-sized stage at a time: clean → panel → fix-loop → un-draft)

[Service]
Type=oneshot
# A systemd stop mid-tick SIGTERMs the run; a signalled shutdown is a CLEAN exit,
# not a failure. The self-heal wrapper already normalizes 143/130 to 0; this is the
# belt-and-suspenders so any future bypass of the wrapper still doesn't mark a
# SIGTERM stop as Failed.
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# Leader-only singleton: run only on the host whose GARDEN identity matches the
# journal `leader` marker. The driver posts stage jobs and surfaces a halt to the
# maintainer inbox; running it on two hosts would double-post the halt note (stage
# promotion itself is CAS-deduped, but the maintainer note is not). On a follower the
# timer still fires but this ExecCondition fails, so the tick is SKIPPED CLEANLY
# (condition-failed, never marked Failed). Each firing re-evaluates, so a leader
# change is picked up next tick with no restart. Mirrors garden-orchestrate exactly.
# See issue kriskowal/garden#11 (Multibot) and designs/multibot-leader-follower.md.
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-gauntlet -- @GARDEN_ROOT@/scripts/jobs/gauntlet.sh
# The self-heal responder runs synchronously on a failed tick before the wrapper
# returns the failing rc; give it headroom beyond the implicit 90s oneshot start
# timeout so a diagnosis is not cut off (responder itself is hard-bounded by
# SELF_HEAL_RESPONDER_TIMEOUT).
TimeoutStartSec=900
