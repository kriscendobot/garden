[Unit]
Description=Garden activity-feed watcher (%i)
Documentation=file:%h/scripts/watcher/README.md
Documentation=file:%h/designs/driver.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/scripts/jobs/self-heal-run.sh garden-watcher@%i -- %h/scripts/watcher/%i/watcher.sh
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal
# %i is the feed slug; it must match a directory under
# scripts/watcher/<feed>/ that contains a watcher.sh.

[Install]
WantedBy=default.target
