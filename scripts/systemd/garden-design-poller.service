[Unit]
Description=Garden design-queue poller
Documentation=file:%h/skills/design-poller/SKILL.md
Documentation=file:%h/designs/driver.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/scripts/jobs/self-heal-run.sh garden-design-poller -- %h/scripts/daemons/design-poller.sh endo-but-for-bots
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal
# Single-instance: one poller per driver container, hard-coded to the
# only active project. A future templated variant (garden-design-poller@.service
# with %i as the project slug) lands when a second project comes online.

[Install]
WantedBy=default.target
