[Unit]
Description=Garden CI-status watcher for repo %i
# Producer: watch one gated repo's OWN open bot-authored PRs and auto-post a
# shepherd job when CI goes red. Driven by its .timer. Monitoring-safety gated:
# armed only for repos in the journal's comment-repos/ set (the same cleared set
# the comment watcher uses), reconciled by the repo-watcher. See ci-watcher.sh.

[Service]
Type=oneshot
# A systemd stop mid-tick SIGTERMs the run; a signalled shutdown is a CLEAN exit,
# not a failure. The self-heal wrapper normalizes 143/130 to 0; this is the belt.
SuccessExitStatus=143 130 SIGTERM SIGINT
# Graceful drain on stop/restart. The source's `gh --paginate` forks git credential
# helpers; KillMode=mixed sends the initial SIGTERM only to the main process
# (self-heal-run.sh → ci-watcher.sh), whose EXIT/INT/TERM trap then reaps the
# source's whole process group and sweeps the unit cgroup for stragglers that escaped
# it (on every exit, clean ticks included); the cgroup-wide SIGKILL backstop at
# TimeoutStopSec catches anything left. Mirrors garden-comment-watcher@.service.
KillMode=mixed
# Short stop timeout: the CI poll holds NO in-flight work worth preserving (a killed
# tick simply re-polls next firing — a shepherd is posted only after a verified
# board read), so a straggler git is SIGKILLed by the cgroup backstop well before
# the next 90s firing rather than racing it.
TimeoutStopSec=20s
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# Leader-only singleton: run only on the host whose GARDEN identity matches the
# journal `leader` marker. On a follower the timer still fires but this
# ExecCondition fails, so the tick is SKIPPED CLEANLY (condition-failed, never
# marked Failed) — that IS follower mode, and it is what stops the shepherd from
# being double-posted across hosts. Each firing re-evaluates, so a leader change is
# picked up next tick with no restart. See CLAUDE.md § Leader and follower hosts.
ExecCondition=/bin/bash @GARDEN_ROOT@/scripts/jobs/is-main-host.sh
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-ci-watcher@%i -- @GARDEN_ROOT@/scripts/jobs/ci-watcher.sh %i
# Drain backstop (recurred 6x on this unit 2026-09-24T11:32..09-25T04:00 after the
# comment-watcher fix adea391f9540 skipped it). When the main process exits, systemd
# SIGKILLs what is left in the cgroup but does NOT wait for it to leave, so a git in
# uninterruptible I/O can outlive the unit and be "Found left-over" by the next
# start. ExecStopPost runs after that sweep in this cgroup and holds the unit in
# "deactivating" until cgroup.procs is empty (bounded 15s < the 20s TimeoutStopSec),
# logging each straggler. `-`: a drain problem never fails the unit. Mirrors
# garden-comment-watcher@.service; see scripts/jobs/cgroup-drain.sh.
ExecStopPost=-/bin/bash @GARDEN_ROOT@/scripts/jobs/cgroup-drain.sh %n
# The self-heal responder runs synchronously on a failed tick before the wrapper
# returns the failing rc; give it headroom beyond the implicit 90s oneshot start
# timeout (responder itself is hard-bounded by SELF_HEAL_RESPONDER_TIMEOUT).
TimeoutStartSec=900
