[Unit]
Description=Garden state-clone-keeper timer

[Timer]
# Absolute wall-clock schedule, NOT a relative OnActiveSec/OnUnitActiveSec pair:
# a relative first-elapse window larger than the fleet's ~1-minute daemon-reload
# cadence is re-armed before it elapses and can be deferred indefinitely (see
# garden-library-source-drift-scan.timer for the full rationale).
#
# Hourly at :22, off the :00/:30 clone-keeper and :15/:45 journal-worktree-keeper
# anchors so the three keepers never contend for the same minute. Hourly is
# ample: the leak accrues at roughly one clone per job, and the idle floor is 6h,
# so nothing becomes eligible faster than the sweep can reach it.
OnCalendar=*:22
Persistent=true

[Install]
WantedBy=timers.target
