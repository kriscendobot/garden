[Unit]
Description=Garden reputation reducer timer

[Timer]
# Absolute wall-clock schedule (every 5 minutes at :02 past), NOT a relative
# OnActiveSec/OnUnitActiveSec pair (a relative first-elapse larger than the fleet's
# ~1-minute reload cadence can be deferred indefinitely — see the foreman timer's
# note). Offset from the foreman's :04/5 so the two leader ticks do not bunch.
# Persistent=true catches up a run missed across downtime.
OnCalendar=*:02/5
Persistent=true

[Install]
WantedBy=timers.target
