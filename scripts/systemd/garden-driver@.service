[Unit]
Description=Garden driver lane %i
Documentation=file:%h/scripts/driver/README.md
Documentation=file:%h/designs/driver.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/scripts/driver/driver.sh %i
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal
# %i is the lane number; the driver discriminates per-lane state files,
# subscriptions, gardener-inbox messages, and journal entries by it.

[Install]
WantedBy=default.target
