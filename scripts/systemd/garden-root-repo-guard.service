[Unit]
Description=Garden root-repo-guard (assert the deployed root repo's invariants — canonical origin, HEAD detached at a main2 ancestor — and repair + alert on drift, so a job that escapes into $GARDEN_ROOT/.git can no longer leave the fleet running a corrupted root for days; also watches for a stalled deploy)

[Service]
Type=oneshot
# A systemd stop mid-tick SIGTERMs the run; a signalled shutdown is a CLEAN exit,
# not a failure. The self-heal wrapper already normalizes 143/130 to 0; this is the
# belt-and-suspenders so any future bypass of the wrapper still doesn't mark a
# SIGTERM stop as Failed.
SuccessExitStatus=143 130 SIGTERM SIGINT
Environment=GARDEN_ROOT=@GARDEN_ROOT@
# EVERY host (NOT leader-gated): each host has its own root checkout that a local job
# can corrupt independently, so the guard runs everywhere — no ExecCondition.
ExecStart=/bin/bash @GARDEN_ROOT@/scripts/jobs/self-heal-run.sh garden-root-repo-guard -- @GARDEN_ROOT@/scripts/jobs/root-repo-guard.sh
# The self-heal responder runs synchronously on a failed tick before the wrapper
# returns; give it headroom beyond the implicit 90s oneshot start timeout.
TimeoutStartSec=900
