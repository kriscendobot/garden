#!/bin/bash
# config.sh.example -- host-local configuration template for the
# garden's driver lanes and per-feed watchers.
#
# Copy this file to scripts/daemons/config.sh and edit. The actual
# config.sh is gitignored; this .example is the template every host
# starts from.
#
# scripts/daemons/start.sh sources this file to know which lanes and
# which feeds to enable.

# Driver lanes. Each lane identifier becomes a systemd instance:
#   garden-driver@<lane>.service
# Lane identifiers are either bare positive integers (legacy PR-work
# lanes, treated as builder lanes for backward compatibility) or
# `<role>-<N>` (role-prefixed lanes per `designs/driver.md` § Role-prefixed
# lanes). Two drivers on the same host must use different lane identifiers.
#
# Role-prefix discipline:
# - `gardener-1`: single instance per host (the gardener cap is 1).
#   Subscribes to `journal/inboxes/<host>/gardener.md` and
#   `journal/jobs/gardener/open/`; runs the workflow at
#   `skills/driver-gardener-workflow/SKILL.md`. Default cadence 180s.
# - `librarian-1`, `librarian-2`: up to two per host. Subscribe to
#   the librarian inbox and job board; run the workflow at
#   `skills/driver-librarian-workflow/SKILL.md`. Default cadence 300s.
# - `builder-N`, `fixer-N`, `weaver-N`: PR-work lanes. Subscribe to
#   the role's job board; run the appropriate PR-creation-flow
#   workflow. Default cadence 30s.
#
# The daemons-script enforces the gardener cap (1) and the librarian
# cap (2 initially); PR-work lanes have no hard cap. Per-lane cadence
# is editable on each lane's state file at
# `journal/drivers/<host>/<lane>.md` (the `cadence_seconds:` field).
# shellcheck disable=SC2034  # consumed by scripts/daemons/{start,stop,status}.sh after sourcing
GARDEN_DRIVER_LANES=(gardener-1 librarian-1 builder-1 builder-2)

# Per-feed watcher daemons. Each feed slug must match a directory
# under scripts/watcher/<feed>/ that contains a watcher.sh.
# The instance unit is:
#   garden-watcher@<feed>.service
# shellcheck disable=SC2034  # consumed by scripts/daemons/{start,stop,status}.sh after sourcing
GARDEN_WATCHER_FEEDS=(endo-but-for-bots)
