garden-fork/${branch}\"\n551:  if remote_sha=\"$(probe_branch_retry \"$selected_source\")\"; then\n562:fetch_branch \"$selected_source\" \"$selected_ref\" \"$selected_label\" || true\n564:# The selected remote-tracking head MUST equal the advertised remote tip, else\n565:# the fetch silently failed or delivered a stale ref. Retry once, then refuse.\n567:if [ \"$have_sha\" != \"$remote_sha\" ]; then\n568:  log \"WARN: ensure-project-worktree: ${selected_ref} is ${have_sha:-<absent>} but ${selected_label}/${branch} is ${remote_sha}; retrying fetch\"\n569:  fetch_branch \"$selected_source\" \"$selected_ref\" \"$selected_label\" || true\n572:if [ \"$now_sha\" != \"$remote_sha\" ]; then\n573:  die \"ensure-project-worktree: could not fetch ${selected_label}@${branch} to ${remote_sha} (remote-tracking head is ${now_sha:-absent}, likely a transient network/auth failure); refusing to hand back a stale tree\"\n577:# remote-tracking ref we just fetched and verified — refs/heads/$branch is no\n578:# longer fetched into and may be absent or held by another worktree. An explicit\n583:git --git-dir=\"$bare\" worktree add --detach \"$wt\" \"$add_ref\" >/dev/null \\\n        [ -n \"$rel\" ] || continue\n        [ -d \"$cache_dir/trees/$rel\" ] || continue\n        [ -e \"$wt/$rel\" ] && continue          # never clobber (fresh tree has none)\n        link_tree \"$cache_dir/trees/$rel\" \"$wt/$rel\" && n=$((n+1))\n      done < \"$cache_dir/manifest\"\n      touch \"$cache_dir\" \"$complete\" 2>/dev/null || true   # LRU: last-use, not last-build\n\n      # ── Link-state reconcile ──────────────────────────────────────────────\n      # The cache holds node_modules trees ONLY, but a package manager keeps its\n      # \"is this project installed?\" state OUTSIDE them: yarn 4 writes\n      # .yarn/install-state.gz at the project root (and .yarn-state.yml under the\n      # node-modules linker), and both are gitignored, so a fresh `git worktree\n      # add` has neither. The linked-in tre