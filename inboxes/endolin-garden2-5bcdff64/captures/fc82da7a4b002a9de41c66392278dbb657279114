P_PORT = 3225;\n+const MCP_BASE = `http://localhost:${MCP_PORT}`;\n+const RESOURCE = `${MCP_BASE}/mcp`;\n+\n+let authorizationServer: OAuth2Server;\n+let httpServer: Server;\n+\n+beforeAll(async () => {\n+  authorizationServer = await startMockAuthServer(AUTHORIZATION_SERVER_PORT);\n+  process.env.OAUTH_ISSUER = authorizationServer.issuer.url!;\n+  process.env.MCP_RESOURCE_URL = RESOURCE;\n+  process.env.PORT = String(MCP_PORT);\n+  process.env.MCP_SCOPES_SUPPORTED = \"mcp/tools mcp/guest\";\n+  process.env.OAUTH_ALLOWED_CLIENT_IDS = \"minion-cli\";\n+  process.env.ACCOUNT_STORE = \"memory\";\n+  process.env.ACCOUNT_AUTOPROVISION = \"on\";\n+  delete process.env.ENDO_SOCK;\n+\n+  const policy = { version: 1, identities: [], default: { scopes: [] } };\n+  const policyPath = join(\n+    tmpdir(),\n+    `minion-guest-memory-http-policy-${AUTHORIZATION_SERVER_PORT}.json`,\n+  );\n+  writeFileSync(policyPath, JSON.stringify(policy));\n+  process.env.MCP_POLICY_PATH = policyPath;\n+\n+  const { loadConfig } = await import(\"../src/config.js\");\n+  const { createApp } = await import(\"../src/http.js\");\n+  const app = await createApp(loadConfig());\n+  await new Promise<void>((resolve) => {\n+    httpServer = app.listen(MCP_PORT, resolve);\n+  });\n+}, 30_000);\n+\n+afterAll(async () => {\n+  await new Promise<void>((resolve) => httpServer.close(() => resolve()));\n+  await authorizationServer.stop();\n+});\n+\n+describe(\"in-memory guest HTTP fallback\", () => {\n+  it(\"round-trips guest text when ENDO_SOCK is unset\", async () => {\n+    const { accessToken } = await runOAuthFlow({\n+      mcpBase: MCP_BASE,\n+      resource: RESOURCE,\n+      scope: \"mcp/tools mcp/guest\",\n+      sub: \"memory-fallback-user\",\n+      idp: \"GitHub\",\n+    });\n+    const transport = new StreamableHTTPClientTransport(new URL(RESOURCE), {\n+      requestInit: { headers: { Authorization: `Bearer ${accessToken}` } },\n+    });\n+    const client = new Client({ name: \"test\", version