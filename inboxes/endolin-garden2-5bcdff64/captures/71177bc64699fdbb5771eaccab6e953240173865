2.yml\n  # already documents); the build cache is keyed by toolchain + lock\n  # so a pin bump starts a fresh blob instead of layering stale\n  # fingerprints.\n  fuzz-ironhorse:\n    name: fuzz-ironhorse\n\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n\n    env:\n      # The toolchain the fuzz targets build with. Locally validated\n      # against the whole target set before each bump.\n      FUZZ_TOOLCHAIN: nightly-2026-08-15\n\n    steps:\n      - name: Checkout\n        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2\n        with:\n          persist-credentials: false\n          # Depth 2 so the pull_request merge commit's parents exist\n          # for the change probe below.\n          fetch-depth: 2\n\n      - name: Detect ironhorse-relevant changes\n        id: changes\n        if: github.event_name == 'pull_request'\n        run: |\n          # test-ironhorse's probe plus this job's extra inputs: the\n          # fuzz build links the XS oracle, so the moddable gitlink,\n          # .gitmodules, and the shared xsnap platform sources are\n          # fuzz-relevant even though the test job ignores them\n          # (review finding: an oracle-input change skipping the lane\n          # detonates on the next unrelated PR). The merge commit's\n          # first parent is the base branch head, so this diff is\n          # exactly the PR's change set; fail open if that shape ever\n          # doesn't hold.\n          if ! git rev-parse -q --verify HEAD^2 >/dev/null; then\n            echo \"hit=true\" >> \"$GITHUB_OUTPUT\"\n          elif git diff --name-only HEAD^1 HEAD \\\n            | grep -qE '^rust/engine/|^rust/endo/ironhorse-store-sqlite/|^Cargo\\.toml$|^Cargo\\.lock$|^\\.github/workflows/ci\\.yml$|^c/moddable|^\\.gitmodules$|^rust/endo/xsnap/xsnap-platform\\.'; then\n            echo \"hit=true\" >> \"$GITHUB_OUTPUT\"\n          else\n            echo \"hit=false\" >> \"$GITHUB_OUTPUT\"\n          fi\n\n      - name: Fetch XS oracle submodule\n        if: github.event_name != 'pull_request' || steps.changes.outputs.hit == 'true'\n        # The ironhorse-fuzz lib links the XS oracle for its\n        # differential targets, so the fuzz build needs the pinned\n        # moddable sources even though this smoke set is decode-only.\n        # Anonymous shallow fetch can hit transient throttling on\n        # shared runner egress; retry before failing, and fail LOUD if\n        # all attempts leave the sources absent (a bare `|| sleep`\n        # loop would swallow the failure).\n        run: |\n          for i in 1 2 3; do\n            git submodule update --init --depth 1 c/moddable && break\n            sleep $((10 * i))\n          done\n          test -f c/moddable/xs/sources/xsAll.h\n\n      - name: Cache Cargo + fuzz build\n        if: github.event_name != 'pull_request' || steps.changes.outputs.hit == 'true'\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            ~/.cargo/bin\n            rust/engine/ironhorse-fuzz/fuzz/target\n          key: ${{ runner.os }}-ironhorse-fuzz-build-${{ env.FUZZ_TOOLCHAIN }}-${{ hashFiles('rust/engine/ironhorse-fuzz/fuzz/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-ironhorse-fuzz-build-${{ env.FUZZ_TOOLCHAIN }}-\n\n      - name: Cache fuzz corpus\n        if: github.event_name != 'pull_request' || steps.changes.outputs.hit == 'true'\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: rust/engine/ironhorse-fuzz/fuzz/corpus\n          # Run-unique primary key: never an exact hit, so every run\n          # SAVES its grown corpus; the prefix restore pulls the\n          # newest prior corpus in scope. Fork-PR poisoning is fenced\n          # by GitHub's cache scoping (PR-scoped saves are invisible\n          # to base-branch runs), and crashing inputs land in\n          # artifacts/, never corpus/.\n          key: ${{ runner.os }}-ironhorse-fuzz-corpus-${{ github.run_id }}\n          restore-keys: |\n            ${{ runner.os }}-ironhorse-fuzz-corpus-\n\n      - name: Install pinned nightly toolchain and cargo-fuzz\n        if: github.event_name != 'pull_request' || steps.changes.outputs.hit == 'true'\n        run: |\n          rustup toolchain install \"$FUZZ_TOOLCHAIN\" --profile minimal\n          command -v cargo-fuzz >/dev/null || cargo install cargo-fuzz --locked\n\n      - name: Check fuzz lockfile freshness\n        if: github.event_name != 'pull_request' || steps.changes.outputs.hit == 'true'\n        working-directory: rust/engine/ironhorse-fuzz\n        # `cargo fuzz run` itself does not take --locked, so a stale\n        # committed fuzz/Cargo.lock would silently float new registry\n        # deps at build time (review finding). Fail the PR that made\n        # it stale instead, with the fix in the error message.\n        run: |\n          cargo +\"$FUZZ_TOOLCHAIN\" fetch --locked --manifest-path fuzz/Cargo.toml || {\n            echo \"::error::fuzz/Cargo.lock is stale — run 'cargo update --workspace' in rust/engine/ironhorse-fuzz/fuzz and commit the lock\"\n            exit 1\n          }\n\n      - name: Fuzz smoke (30s per target)\n        if: github.event_name != 'pull_request' || steps.changes.outputs.hit == 'true'\n        working-directory: rust/engine/ironhorse-fuzz\n        # Accumulate failures instead of stopping at the first\n        # crashing target, so one red run surfaces every crashing\n        # target's artifact at once.\n        run: |\n          rc=0\n          for t in snapshot_decoder snapshot_roundtrip bytecode_decoder parser; do\n            cargo +\"$FUZZ_TOOLCHAIN\" fuzz run \"$t\" -- -max_total_time=30 -print_final_stats=1 || rc=1\n          done\n          exit \"$rc\"\n\n      - name: Upload crash artifacts\n        if: failure()\n        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n        with:\n          name: ironhorse-fuzz-artifacts\n          path: rust/engine/ironhorse-fuzz/fuzz/artifacts/\n          if-no-files-found: ignore\n\n  test-ocapn-python:\n    name: test-ocapn-python\n\n    runs-on: ubuntu-latest\n\n    steps:\n      - name: Checkout Endo\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          path: endo\n          persist-credentials: false\n\n      - name: Checkout OCapN Test Suite\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          # https://github.com/ocapn/ocapn-test-suite/ (main branch)\n          repository: ocapn/ocapn-test-suite\n          ref: 74db78f08a40efba1e2b975d809374ff0e7acf60\n          path: ocapn-test-suite\n          persist-credentials: false\n\n      - run: corepack enable\n        working-directory: endo\n\n      - name: Use Node.js\n        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0\n        with:\n[package]\nname = \"ironhorse-fuzz\"\ndescription = \"cargo-fuzz targets (design § Fuzzability): target 1 differential source fuzzing, target 2 bytecode decoder. The comparison and generation logic is a plain, testable lib so it builds without a libFuzzer toolchain. #![forbid(unsafe_code)].\"\nversion.workspace = true\nedition.workspace = true\nlicense.workspace = true\npublish.workspace = true\n\n[lib]\nname = \"ironhorse_fuzz\"\npath = \"src/lib.rs\"\n\n[dependencies]\nironhorse-vm = { path = \"../ironhorse-vm\" }\nxs-oracle = { path = \"../xs-oracle\" }\nironhorse-regexp = { path = \"../ironhorse-regexp\" }\nironhorse-compile = { path = \"../ironhorse-compile\" }\n# Stage-6 child 4: the snapshot round-trip-invariance and malformed-atom\n# decoder fuzz arms drive the XS_M writer/reader (design § Snapshots,\n# Fuzzability). The substance stays here in the forbid(unsafe_code) lib so it\n# builds and unit-tests without