erately, together).\n  FUZZ_TOOLCHAIN: nightly-2026-08-15\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: false\n\njobs:\n  deep-fuzz:\n    name: deep-fuzz\n\n    runs-on: ubuntu-latest\n    # Four targets at up to 15 minutes each, plus the cold build.\n    timeout-minutes: 120\n\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Fetch XS oracle submodule\n        # The ironhorse-fuzz lib links the XS oracle for its\n        # differential targets. Anonymous shallow fetch can hit\n        # transient throttling on shared runner egress; retry before\n        # failing, and fail LOUD if all attempts leave the sources\n        # absent.\n        run: |\n          for i in 1 2 3; do\n            git submodule update --init --depth 1 c/moddable && break\n            sleep $((10 * i))\n          done\n          test -f c/moddable/xs/sources/xsAll.h\n\n      - name: Cache Cargo + fuzz build\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            ~/.cargo/bin\n            rust/engine/ironhorse-fuzz/fuzz/target\n          key: ${{ runner.os }}-ironhorse-fuzz-build-${{ env.FUZZ_TOOLCHAIN }}-${{ hashFiles('rust/engine/ironhorse-fuzz/fuzz/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-ironhorse-fuzz-build-${{ env.FUZZ_TOOLCHAIN }}-\n\n      - name: Cache fuzz corpus\n        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: rust/engine/ironhorse-fuzz/fuzz/corpus\n          # The SAME key family as ci.yml's smoke lane: run-unique\n          # primary key (never an exact hit, so every run SAVES its\n          # grown corpus), prefix restore pulling the newest corpus\n          # in scope — smoke and dee