tra `gh pr list`, never the job.\\n\\n_recorded_pr_inner() {\\n  local rec_repo rec_num\\n  ensure_clone \\\"$DIR\\\" >/dev/null 2>&1 || return 1\\n  sync_clone \\\"$DIR\\\"   >/dev/null 2>&1 || return 1\\n  [ -f \\\"$DIR/work/$base\\\" ] || return 1\\n  rec_num=\\\"$(sed -n 's/^pr_number:[[:space:]]*//p' \\\"$DIR/work/$base\\\" | head -1)\\\"\\n  rec_repo=\\\"$(sed -n 's/^pr_repo:[[:space:]]*//p'  \\\"$DIR/work/$base\\\" | head -1)\\\"\\n  [[ \\\"$rec_num\\\" =~ ^[0-9]+$ ]] || return 1\\n  # A record naming a different repo is ignored rather than trusted.\\n  [ \\\"$rec_repo\\\" = \\\"$repo\\\" ] || return 1\\n  printf '%s\\\\n' \\\"$rec_num\\\"\\n}\\n\\n# recorded_pr — print the PR number already recorded for THIS base and repo.\\nrecorded_pr() {\\n  local num\\n  journal_enabled || return 1\\n  num=\\\"$( _recorded_pr_inner 2>/dev/null )\\\" || return 1\\n  [ -n \\\"$num\\\" ] || return 1\\n  printf '%s\\\\n' \\\"$num\\\"\\n}\\n50:#                [--no-draft] [--find-only] [--author LOGIN] [--limit N]\\n57:#   --find-only    look, never create. Exit 2 when nothing is found.\\n70:#   2  --find-only and no PR exists (nothing on stdout)\\n103:    --find-only) find_only=1; shift ;;\\n339:  log \\\"no open PR for job '$base' on $repo (--find-only)\\\"\\n/home/kris/garden2/.garden-state/library-link-check/journal/jobs/todo/ironhorse-fuzz-6fec81f3b42a99c1-repair.md\\n/home/kris/garden2/.garden-state/library-link-check/journal/jobs/todo/ironhorse-fuzz-91afec2d990bc402-repair.md\\n/home/kris/garden2/.garden-state/library-link-check/journal/jobs/todo/ironhorse-fuzz-3fc02d8b57faa79a-repair.md\\n/home/kris/garden2/.garden-state/library-link-check/journal/jobs/todo/ironhorse-fuzz-637d760bc2e0278e-repair.md\\n/home/kris/garden2/.garden-state/library-link-check/journal/jobs/todo/ironhorse-fuzz-ed616f6ec22095dc-repair.md\\n/home/kris/garden2/.garden-state/library-link-check/journal/jobs/todo/ironhorse-fuzz-3310b49d21f64878-repair.md\\n/home/kris/garden2/.garden-state/library-li